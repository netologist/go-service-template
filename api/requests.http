@baseUrl = http://localhost:8080
@contentType = application/json

### ==============================================================================
### Healthcheck Probe
### ==============================================================================

# @name HealthCheck
GET {{baseUrl}}/healthz
Accept: application/json

###
# Expected:
# HTTP 200
# response.body.status == "ok"

### ==============================================================================
### List Hotels (Read before Create)
### ==============================================================================

# @name ListHotels
GET {{baseUrl}}/api/v1/hotels
Accept: application/json

###
# Expected:
# HTTP 200
# response.body is an array of Hotel objects

### ==============================================================================
### Create Hotel
### ==============================================================================

# @name CreateHotel
POST {{baseUrl}}/api/v1/hotels
Content-Type: {{contentType}}
Accept: application/json

{
  "name": "Grand Budapest Hotel",
  "address": "100 Alpine Way",
  "city": "Lutz"
}

###
# Expected:
# HTTP 201 Created
# response.body.name == "Grand Budapest Hotel"
# response.body.id is a generated UUIDv7

### Capture created hotel ID
@createdHotelId = {{CreateHotel.response.body.id}}

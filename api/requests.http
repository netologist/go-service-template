@baseUrl = http://localhost:8080
@contentType = application/json

### ==============================================================================
### Healthcheck Probe
### ==============================================================================

# @name HealthCheck
GET {{baseUrl}}/healthz
Accept: application/json

###
# Expected:
# HTTP 200
# response.body.status == "ok"

### ==============================================================================
### List Items (Read before Create)
### ==============================================================================

# @name ListItems
GET {{baseUrl}}/api/v1/items
Accept: application/json

###
# Expected:
# HTTP 200
# response.body is an array of Item objects

### ==============================================================================
### Create Item
### ==============================================================================

# @name CreateItem
POST {{baseUrl}}/api/v1/items
Content-Type: {{contentType}}
Accept: application/json

{
  "name": "Mechanical Keyboard",
  "description": "Ergonomic hot-swappable mechanical keyboard",
  "price": 9900
}

###
# Expected:
# HTTP 201 Created
# response.body.name == "Mechanical Keyboard"
# response.body.id is a generated UUIDv7

### Capture created item ID
@createdItemId = {{CreateItem.response.body.id}}

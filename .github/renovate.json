{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinDigestsDisabled",
    "docker:pinDigests"
  ],
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "matchManagers": ["dockerfile"],
      "pinDigests": true
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go minor and patch dependencies",
      "automerge": false
    }
  ],
  "gomod": {
    "enabled": true
  },
  "github-actions": {
    "enabled": true
  },
  "dockerfile": {
    "enabled": true
  }
}

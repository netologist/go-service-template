# ==============================================================================
# Hotel Booking Platform - Environment Configuration Template
# Copy this file to .env for local overrides (loaded automatically by mise).
# In production/K8s, supply these values via container environment / ConfigMaps / Secrets.
# ==============================================================================

# Application Environment (development | staging | production | test)
APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info

# PostgreSQL Credentials & Connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=S3cr3tP455w0rD
POSTGRES_DB=hotel_booking
DATABASE_URL=postgres://postgres:S3cr3tP455w0rD@localhost:5432/hotel_booking?sslmode=disable

# HTTP Server Timeouts & Graceful Shutdown
SERVER_SHUTDOWN_TIMEOUT=10s
SERVER_DRAIN_TIMEOUT=5s
SERVER_READ_HEADER_TIMEOUT=30s
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=2m

# PostgreSQL Pool Settings
DB_MAX_CONNS=25
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m
DB_PING_TIMEOUT=5s
